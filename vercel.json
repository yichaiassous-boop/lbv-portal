{
  "rewrites": [
    { "source": "/api/hotels", "destination": "/api/quotes?_h=1" },
    { "source": "/api/events", "destination": "/api/quotes?_e=1" },
    { "source": "/api/artists", "destination": "/api/quotes?_a=1" },
    { "source": "/api/nets", "destination": "/api/quotes?_n=1" },
    { "source": "/api/fun", "destination": "/api/quotes?_f=1" },
    { "source": "/api/twin", "destination": "/api/quotes?_t=1" },
    { "source": "/api/intake", "destination": "/api/quotes?_i=1" },
    { "source": "/api/walink", "destination": "/api/quotes?_w=1" }
  ],
  "headers": [
    { "source": "/app/(.*)\\.apk", "headers": [
